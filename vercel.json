{
  "version": 2,
  "functions": {
    "backend/api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "backend/dbconfig/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "backend/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/$1.php"
    },
    {
      "src": "/dbconfig/(.*)",
      "dest": "/backend/dbconfig/$1.php"
    },
    {
      "src": "/backend-index",
      "dest": "/backend/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
