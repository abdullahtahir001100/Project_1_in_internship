{
  "version": 2,
  "functions": {
    "backend/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/Employees/(.*)",
      "dest": "/backend/api/Employees/$1.php"
    },
    {
      "src": "/api/Posts/(.*)",
      "dest": "/backend/api/Posts/$1.php"
    },
    {
      "src": "/api/vouchers/(.*)",
      "dest": "/backend/api/vouchers/$1.php"
    },
    {
      "src": "/api/dbconfig/(.*)",
      "dest": "/backend/dbconfig/$1.php"
    },
    {
      "src": "/api/index",
      "dest": "/backend/index.php"
    }
  ]
}
