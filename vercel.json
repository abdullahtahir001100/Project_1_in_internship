{
  "version": 2,
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "backend/api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/$1.php"
    },
    {
      "src": "/api/dbconfig/(.*)",
      "dest": "/backend/dbconfig/$1.php"
    }
  ]
}
