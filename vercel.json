{
  "version": 2,
  "builds": [
    {
      "src": "backend/**/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/api/$1.php"
    },
    {
      "src": "/dbconfig/(.*)",
      "dest": "/backend/dbconfig/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
